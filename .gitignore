.env
/bin/
*.exe
*.test
coverage.out

# Web toolchain output. The embedded UI is built from web/ into
# internal/webui/dist; only the placeholder that keeps go:embed compiling is
# tracked.
web/node_modules/
web/coverage/
web/test-results/
web/playwright-report/
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Local backup dumps and benchmark scratch output.
/backups/
/benchmarks/raw/*.tmp
