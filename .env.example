DATABASE_URL=postgres://stockflow:stockflow@localhost:5432/stockflow?sslmode=disable
STOCKFLOW_TEST_DATABASE_URL=postgres://stockflow:stockflow@localhost:5432/stockflow_test?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
MIGRATE_ON_START=true
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Operator authentication (required outside demo mode) ---
# A production start fails fast unless username, password hash, and session
# secret are all set. Generate them with:
#   go run ./cmd/api hash-password 'a-strong-password'   # -> STOCKFLOW_OPERATOR_PASSWORD_HASH
#   go run ./cmd/api new-secret                          # -> STOCKFLOW_SESSION_SECRET
STOCKFLOW_OPERATOR_USERNAME=operator
STOCKFLOW_OPERATOR_PASSWORD_HASH=
STOCKFLOW_SESSION_SECRET=
STOCKFLOW_SESSION_TTL=12h
STOCKFLOW_COOKIE_SECURE=true
STOCKFLOW_LOGIN_MAX_ATTEMPTS=10

# --- Explicit local demo only ---
# When true, missing auth values fall back to the documented non-secret demo
# defaults (username "operator", password "stockflow-demo") and cookies are not
# marked Secure so the http demo works. Never enable in production. Docker
# Compose sets this for the local demo. No password value is stored here.
STOCKFLOW_DEMO_MODE=false
